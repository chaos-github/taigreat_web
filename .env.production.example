APP_NAME="Heng Zhan Tang"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://construction.taigreat.com.tw
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=taigreat_web
DB_USERNAME=taigreat_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BOOST_ENABLED=false
BOOST_BROWSER_LOGS_WATCHER=false
# Set exact cloudflared / Docker host gateway IPs for your deployment.
# Example for a host tunnel: 127.0.0.1,::1,172.18.0.1
TRUSTED_PROXIES=
# Public tunnel traffic to /console is denied. Manage it locally or over VPN.
CONSOLE_ALLOW_PRIVATE_NETWORKS=false
CONSOLE_ALLOWED_IPS=
HSTS_ENABLED=false
MAIL_MAILER=log
